# ============================================================
# KattaBaza — muhit o'zgaruvchilari
# Bu faylni `.env` nomi bilan NUSXALANG va to'ldiring.
# ⚠️  `.env` ni HECH QACHON git'ga qo'shmang va chatga yozmang.
# ============================================================

# ---------- Lokal server (server/index.js) ----------
PORT=3000
HOST=127.0.0.1

# Katalog: Google Sheet (server opensheet orqali o'qiydi va keshlaydi)
SHEET_ID=1z7O8Xlq5WN3VRv45lEyTu4QpW6O3tEcefsg5O5y1y5g
MATERIALS_TAB=Materials
CHANNELS_TAB=Channels
CACHE_SECONDS=120

# Kalitlar. Tavsiya: kalitlarni ALOHIDA yangi jadvalga ko'chirib, ID sini shu yerga yozing.
KEYS_SHEET_ID=
KEYS_TABS=key_list
# KEYS_PASSWORD berilsa - doimiy parol; bo'sh bo'lsa - vaqtli parol:
# PREFIX + (Toshkent vaqti + OFFSET daqiqa) HHMM
KEYS_PASSWORD=
KEYS_PASSWORD_PREFIX=Kitob
KEYS_PASSWORD_OFFSET_MIN=71
KEYS_TIMEZONE=Asia/Tashkent
KEYS_SESSION_MINUTES=30
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=

# ---------- Ma'lumotlar bazasi (Supabase) ----------
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Frontend uchun (bularni brauzer ko'radi — bu normal, RLS himoya qiladi)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ⚠️ Faqat server (bot/worker) uchun. RLS ni chetlab o'tadi. Frontendga TUSHMASIN!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---------- Telegram: botlar ----------
# @BotFather dan olinadi. Har kanalga alohida bot bo'lsa, alohida kalit.
BOT_TOKEN_APPS=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN_MEDICINA=

# Admin Telegram user ID lari (vergul bilan) — faqat shular buyruq bera oladi
ADMIN_IDS=

# ---------- Telegram: userbot (MTProto) ----------
# https://my.telegram.org → API development tools
# ⚠️ Shaxsiy asosiy raqamni ishlatmang — alohida akkaunt oching (ban riski bor)
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=kattabaza_userbot
# Ixtiyoriy: local Bot API server (2 GB limit uchun)
# TG_LOCAL_API_URL=http://localhost:8081

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kattabaza
R2_PUBLIC_URL=https://cdn.kattabaza.uz

# ---------- Ko'chirish sozlamalari ----------
# Rate limit — bularni PASAYTIRMANG, ban bo'lasiz
COPY_DELAY_SECONDS=1.5          # har fayl orasidagi pauza (soniya)
BATCH_PAUSE_EVERY=100           # nechta fayldan keyin uzun pauza
BATCH_PAUSE_SECONDS=60
MAX_JOB_ATTEMPTS=5
MAX_FILE_MB=2000                # bundan katta fayl o'tkazib yuboriladi

# R2 issiq kesh
R2_CACHE_MAX_FILE_MB=200        # bundan kattasi keshga tushmaydi
R2_CACHE_TTL_DAYS=30            # tegilmasa o'chiriladi

# ---------- Sayt: ma'lumot manbai ----------
# sheet    = Google Sheets, lokal server orqali (hozircha shu)
# supabase = faqat baza
# auto     = avval baza, bo'sh bo'lsa Sheets
VITE_DATA_SOURCE=sheet
# (migratsiya skripti ham yuqoridagi SHEET_ID ni ishlatadi)
